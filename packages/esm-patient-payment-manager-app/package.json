{
  "name": "@clinicemr/esm-patient-payment-manager-app",
  "version": "1.0.6",
  "license": "MPL-2.0",
  "description": "Role-aware payment manager for OpenMRS CLINICEMR distro: consultation payment gate, billable-service pricing, and order-basket payment requests backed by the cashier module",
  "browser": "dist/openmrs-esm-patient-payment-manager-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "serve": "webpack serve --mode=development",
    "build": "webpack --mode production",
    "lint": "eslint src --ext js,jsx,ts,tsx --max-warnings 0",
    "typescript": "tsc",
    "test": "jest --config jest.config.js --passWithNoTests",
    "extract-translations": "i18next 'src/**/*.component.tsx' 'src/**/*.extension.tsx' --config ../../tools/i18next-parser.config.js"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "microfrontends"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bwongo-digital-solutions/openmrs-clinicemr-esm-patient-chart.git"
  },
  "homepage": "https://github.com/bwongo-digital-solutions/openmrs-clinicemr-esm-patient-chart#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@carbon/react": "^1.83.0",
    "lodash-es": "^4.17.21"
  },
  "peerDependencies": {
    "@openmrs/esm-framework": "*",
    "@openmrs/esm-patient-common-lib": "*",
    "dayjs": "1.x",
    "react": "18.x",
    "react-i18next": "16.x",
    "react-router-dom": "6.x",
    "rxjs": "6.x",
    "swr": "2.x"
  },
  "packageManager": "yarn@4.10.3"
}
